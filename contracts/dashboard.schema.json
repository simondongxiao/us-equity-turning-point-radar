{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Turning Point Radar Dashboard",
  "type": "object",
  "required": [
    "build_mode",
    "records"
  ],
  "properties": {
    "build_mode": {
      "enum": [
        "preview",
        "live"
      ]
    },
    "as_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "directional_model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence_method_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "temporary": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/record"
      }
    },
    "public_config": {
      "type": "object",
      "properties": {
        "api_base_url": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "taxonomy_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "weekly_pool_audit": {
      "type": ["object", "null"],
      "properties": {
        "schema_version": {"type": "string"},
        "as_of": {"type": "string"},
        "mother_pool_observed_count": {"type": "integer", "minimum": 0},
        "complete_popularity_security_count": {"type": "integer", "minimum": 0},
        "regular_pool_count": {"type": "integer", "minimum": 0},
        "automatic_reselection_status": {"type": "string"}
      }
    },
    "index_forecasts": {
      "type": ["object", "null"],
      "properties": {
        "as_of": {"type": ["string", "null"]},
        "records": {"type": "array"},
        "structure_matrix": {
          "type": "object",
          "required": ["version", "as_of", "records", "calendar_method", "note"],
          "properties": {
            "version": {"type": "string"},
            "as_of": {"type": "string"},
            "calendar_method": {"type": "string"},
            "note": {"type": "string"},
            "records": {"type": "array", "items": {"$ref": "#/$defs/index_structure_record"}}
          }
        }
      }
    },
    "storage_rotation": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "status": {
          "type": "string"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "summary": {
          "type": "string"
        },
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "window_sessions": {
                "type": "integer",
                "minimum": 1
              },
              "relative_return": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "status": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "index_structure_record": {
      "type": "object",
      "required": [
        "symbol", "status", "horizon_sessions", "horizon_end_date", "anchor_as_of",
        "core_bottom_source", "core_top_source", "price_location_state", "event_status", "semantic_note"
      ],
      "properties": {
        "symbol": {"type": "string"},
        "name": {"type": ["string", "null"]},
        "kind": {"type": ["string", "null"]},
        "status": {"enum": ["observed", "unavailable"]},
        "horizon_sessions": {"enum": [5, 10, 21]},
        "horizon_label": {"type": "string"},
        "horizon_end_date": {"type": "string"},
        "calendar_method": {"type": "string"},
        "anchor_price": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "anchor_as_of": {"type": "string"},
        "anchor_unit": {"type": ["string", "null"]},
        "core_bottom_zone": {"$ref": "#/$defs/positive_band"},
        "core_top_zone": {"$ref": "#/$defs/positive_band"},
        "pressure_bottom_zone": {"$ref": "#/$defs/positive_band"},
        "pressure_top_zone": {"$ref": "#/$defs/positive_band"},
        "core_bottom_source": {"enum": ["turning_point_conditional_path", "atr_volatility_fallback", "unavailable"]},
        "core_top_source": {"enum": ["turning_point_conditional_path", "atr_volatility_fallback", "unavailable"]},
        "pressure_definition": {"type": "string"},
        "core_bottom_relative_to_anchor_pct": {"$ref": "#/$defs/nullable_number_band"},
        "core_top_relative_to_anchor_pct": {"$ref": "#/$defs/nullable_number_band"},
        "pressure_bottom_relative_to_anchor_pct": {"$ref": "#/$defs/nullable_number_band"},
        "pressure_top_relative_to_anchor_pct": {"$ref": "#/$defs/nullable_number_band"},
        "distance_to_core_bottom_pct": {"type": ["number", "null"], "minimum": 0},
        "distance_to_core_top_pct": {"type": ["number", "null"], "minimum": 0},
        "price_location_state": {"enum": ["in_core_bottom", "near_core_bottom", "between_core_zones", "near_core_top", "in_core_top", "in_lower_pressure", "in_upper_pressure", "below_lower_pressure", "above_upper_pressure", "core_zones_overlap", "unavailable"]},
        "price_location_label": {"type": "string"},
        "dominant_direction": {"type": ["string", "null"]},
        "dominant_probability": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "confidence_level": {"type": ["string", "null"]},
        "confidence_label": {"type": "string"},
        "range_width_pct": {"type": ["number", "null"], "minimum": 0},
        "wide_range_flag": {"type": "boolean"},
        "trigger_condition": {"type": "string"},
        "invalidation_condition": {"type": "string"},
        "main_judgment": {"type": "string"},
        "event_status": {"type": "string"},
        "event_source": {"type": ["string", "null"]},
        "event_observed_at": {"type": ["string", "null"]},
        "event_note": {"type": "string"},
        "semantic_note": {"type": "string"}
      }
    },
    "positive_band": {
      "type": ["array", "null"],
      "items": {"type": "number", "exclusiveMinimum": 0},
      "minItems": 2,
      "maxItems": 2
    },
    "nullable_number_band": {
      "type": ["array", "null"],
      "items": {"type": "number"},
      "minItems": 2,
      "maxItems": 2
    },
    "metric": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "structural_only",
            "uncalibrated",
            "calibrated_low_confidence",
            "calibrated",
            "stale",
            "data_error"
          ]
        },
        "opportunity_value": {
          "type": [
            "number",
            "null"
          ]
        },
        "risk_value": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "opportunity_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "risk_score": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        },
        "expected_return": {
          "type": [
            "number",
            "null"
          ]
        },
        "es95": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "positive_edge": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "p_bottom": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_top": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_upfirst": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_downfirst": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_unhit": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "p_bottom_rebound_first": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "p_top_reversal_first": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "p_no_directional_turn": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "p_two_way_wash": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "confidence_level": {
          "type": ["string", "null"],
          "enum": ["high", "medium", "low", null]
        },
        "confidence_label": {
          "type": ["string", "null"]
        },
        "confidence_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "path_similarity_score": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "validation_ece": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "validation_accuracy_lift": {
          "type": ["number", "null"]
        },
        "validation_accuracy": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "validation_majority_baseline_accuracy": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "validation_test_n": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "validation_unique_dates": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "confidence_reason": {
          "type": ["string", "null"]
        },
        "regime_shift_flag": {
          "type": ["boolean", "null"]
        },
        "bottom_band": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "top_band": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minItems": 2,
          "maxItems": 2
        },
        "volatility_bottom_band": {
          "type": ["array", "null"],
          "items": {"type": "number", "exclusiveMinimum": 0},
          "minItems": 2,
          "maxItems": 2
        },
        "volatility_top_band": {
          "type": ["array", "null"],
          "items": {"type": "number", "exclusiveMinimum": 0},
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "record": {
      "type": "object",
      "required": [
        "symbol",
        "metrics"
      ],
      "properties": {
        "symbol": {
          "type": "string",
          "minLength": 1,
          "maxLength": 20
        },
        "name_zh": {
          "type": "string"
        },
        "coverage_bucket": {
          "type": "string"
        },
        "research_group": {
          "type": "string"
        },
        "as_of": {
          "type": [
            "string",
            "null"
          ]
        },
        "reference_price": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "metrics": {
          "type": "object",
          "required": [
            "5",
            "10",
            "21"
          ],
          "properties": {
            "5": {
              "$ref": "#/$defs/metric"
            },
            "10": {
              "$ref": "#/$defs/metric"
            },
            "21": {
              "$ref": "#/$defs/metric"
            }
          }
        },
        "research_group_id": {
          "type": "string"
        },
        "taxonomy_version": {
          "type": "string"
        },
        "taxonomy_effective_from": {
          "type": "string"
        },
        "metadata_as_of": {
          "type": "string"
        },
        "legacy_research_group": {
          "type": "string"
        },
        "business_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "industry_tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "peer_context": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "status": {
              "enum": [
                "validated",
                "proxy_only",
                "no_peers",
                "insufficient_coverage",
                "identity_unverified",
                "stale",
                "unavailable"
              ]
            },
            "self_excluded": {
              "type": "boolean"
            },
            "peer_symbols": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "peer_count": {
              "type": "integer",
              "minimum": 0
            },
            "effective_n": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0
            },
            "weight_coverage": {
              "type": [
                "number",
                "null"
              ],
              "minimum": 0,
              "maximum": 1
            },
            "note": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
